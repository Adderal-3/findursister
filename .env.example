# 大神基础能力：两项都填写后启用登录、Ulink、分享、导航栏和 NS 业务埋点。
VITE_DS_APP_KEY=l36
VITE_DS_SQUARE_ID=60a61f832a3be16207f9651c

# 大神活动后台创建活动后填写；与 APP_KEY 同时存在时显示任务入口。
VITE_DS_ACT_ID=6a6310d152ee7c17a9007b0b
VITE_DS_TASK_SHOW_ROLE=true

# 仅 CPS 底部栏需要，本项目当前未启用 CPS，可留空。
VITE_DS_FRONT_ID=

# 支持普通浏览器 H5 登录。false 时，站外点击“开始游戏”会引导打开大神 App。
VITE_DS_H5_LOGIN_ENABLED=true

# NS 埋点；没有特殊命名要求可保留默认值。
VITE_DS_EVENT_ACTION=fe_act_find_sister_h5
VITE_DS_EVENT_CATEGORY=act_find_sister_h5

# 分享图必须是已上线的完整 HTTPS 地址，不能写项目内相对路径。
VITE_DS_SHARE_TITLE=忙忙碌碌寻宝藏
VITE_DS_SHARE_DESC=挑战寻宝关卡，寻找汴京珍宝
VITE_DS_SHARE_ICON=https://img.166.net/gameyw-misc/opd/squash/20260630/101947-goc2wybfsi.png

# 小游戏服务端存储与排行榜；当前测试/正式环境共用同一套后台配置。
VITE_DS_DEV_MINI_GAME_ID=6a82ccb34903a32e80a21e2f
VITE_DS_PRO_MINI_GAME_ID=6a82ccb34903a32e80a21e2f
# 总榜继续使用后台历史榜单 ID `yanli_rank`；该 ID 仅为兼容历史配置。
VITE_DS_DEV_BILLBOARD_ID=yanli_rank
VITE_DS_PRO_BILLBOARD_ID=yanli_rank

# 可选 BGM。把文件放到 public/audio/bgm.mp3 后取消下一行注释即可自动循环。
# VITE_GAME_BGM_URL=/audio/bgm.mp3

# 大神 App 内导航栏：主题只允许 white 或 black。
VITE_DS_NAV_TITLE=忙忙碌碌寻宝藏
VITE_DS_NAV_HIDE_TITLE=false
VITE_DS_NAV_THEME=white
